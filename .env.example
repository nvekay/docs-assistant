# --- Infrastructure ---
DATABASE_URL=postgres://docs:docs@localhost:5432/docs_assistant
REDIS_URL=redis://localhost:6379
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- LLM ---
# anthropic = Claude; fake = keyless stand-in for local dev and tests
LLM_PROVIDER=fake
# Pause between words of the fake model (ms), so streaming is visible locally
FAKE_LLM_DELAY_MS=40

ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace (API error asks for anthropic-workspace-id): Console -> Settings -> Workspaces
ANTHROPIC_WORKSPACE_ID=
# claude-haiku-5-5 is the cheapest ($0.10 / $0.50 per 1M tokens); claude-sonnet-5-5 or claude-opus-5-5 cost 20-40x more
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max. Support chat does well at "low".
ANTHROPIC_EFFORT=low
# true = retry on a fallback model when the requested one declines (beta)
ANTHROPIC_FALLBACK=false

# Max answer length in tokens (thinking included): caps the cost of one request
LLM_MAX_TOKENS=8000
# Earlier messages sent with each question (the model remembers the conversation)
CHAT_HISTORY_MESSAGES=24

# --- Cost control (public demo) ---
# USD per 1M tokens of the chat model (Haiku 5.5 here), used for the usage table
PRICE_INPUT_PER_MTOK=0.1
PRICE_OUTPUT_PER_MTOK=0.5
DAILY_TOKEN_LIMIT_PER_USER=200000
CHAT_RATE_LIMIT_PER_MINUTE=10
DAILY_TOKEN_LIMIT_GLOBAL=1000000

# Retrieval: fragments sent to the model (hybrid full-text + vector search), and an optional cutoff (0..1).
# Search uses local keyword embeddings (no API key). Empty RETRIEVAL_MIN_SCORE = default 0.2.
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=

# --- Admin ---
# In production (NODE_ENV=production) the API refuses to start with these default values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-too

# Optional public read-only account for the deployed demo (can view /admin, cannot change anything).
# Set both or neither.
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=

# --- Hosting ---
# development | production. Production adds the Secure flag to the user cookie and checks secrets.
# NODE_ENV=production   (set this on the hosting; leave unset locally)
# true = run the ingestion worker inside the API process (free hosting without background workers)
RUN_WORKER_IN_API=false
