# --- Infrastructure ---
DATABASE_URL=postgres://docs:docs@localhost:5432/docs_assistant
REDIS_URL=redis://localhost:6379
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- LLM ---
# fake | anthropic | openai  ("fake" works without any API keys: handy for local dev and tests)
LLM_PROVIDER=fake
# fake | openai  (embeddings are always OpenAI in production; fake gives deterministic vectors)
EMBEDDING_PROVIDER=fake
# Pause between words of the fake model (ms), so streaming is visible locally
FAKE_LLM_DELAY_MS=40

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Support chat does well at "low".
ANTHROPIC_EFFORT=low

OPENAI_API_KEY=
# Required when LLM_PROVIDER=openai, e.g. the current small OpenAI chat model
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

LLM_MAX_TOKENS=16000

# --- Cost control (public demo) ---
# USD per 1M tokens for the chat model, used for the usage table
PRICE_INPUT_PER_MTOK=4
PRICE_OUTPUT_PER_MTOK=20
DAILY_TOKEN_LIMIT_PER_USER=50000
CHAT_RATE_LIMIT_PER_MINUTE=10
DAILY_TOKEN_LIMIT_GLOBAL=1000000

# Retrieval: chunks sent to the model, and an optional relevance cutoff (0..1).
# Leave RETRIEVAL_MIN_SCORE empty to use the embedding provider default (fake 0.1, OpenAI 0.3).
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=

# --- Admin ---
# In production (NODE_ENV=production) the API refuses to start with these default values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-too

# Optional public read-only account for the deployed demo (can view /admin, cannot change anything).
# Set both or neither.
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=

# --- Hosting ---
# development | production. Production adds the Secure flag to the user cookie and checks secrets.
# NODE_ENV=production   (set this on the hosting; leave unset locally)
# true = run the ingestion worker inside the API process (free hosting without background workers)
RUN_WORKER_IN_API=false
