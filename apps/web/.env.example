# Where the Next.js server proxies /api/* (the NestJS API). Read at build time on Vercel.
API_URL=http://localhost:3001
# Optional: shown as a "Source code" link on the landing page
NEXT_PUBLIC_GITHUB_URL=

# Optional: the public read-only admin account, offered as a button on /admin.
# Must match DEMO_VIEWER_EMAIL / DEMO_VIEWER_PASSWORD on the API.
NEXT_PUBLIC_DEMO_VIEWER_EMAIL=
NEXT_PUBLIC_DEMO_VIEWER_PASSWORD=
